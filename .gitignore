# pi-lens project root for pdkb — keep the repo to real code/docs only.

# Raw markdown corpus (4582 docs, ~106M) + any graphify* extraction-output dirs
graphify*/

# uat / smoke test scratch dirs (test corpus + their graphify-out output)
uat*/
smoke*/

# Watchdog runtime output (snapshot.md rewritten every 10s, hourly logs)
snapshot/

# pi-internal state (subagents, sessions)
.pi/

# Python bytecode / caches
__pycache__/
*.pyc

# Package build artifacts
*.egg-info/

# Virtualenv
.venv/

# Pre-existing scripts/ tooling, kept out of version control
scripts/audit_luna_ocr.py
scripts/graphify-watchdog-uat.py
scripts/luna_ocr_monitor.py
scripts/ocr_qa_checkpoint.py
scripts/paddleocr_convert.py
scripts/queue_next_luna_batch.py
scripts/test_paddleocr_convert.py
