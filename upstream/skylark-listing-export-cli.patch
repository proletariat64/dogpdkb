index 0000000..ac5d895
--- /dev/null
+++ b/test/cli.mjs
@@ -0,0 +1,56 @@
+import { build } from 'esbuild';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, writeFileSync, readFileSync, existsSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import assert from 'node:assert/strict';
+
+await build({entryPoints:['cli.ts'], bundle:true, platform:'node', format:'esm', outfile:'test/.build/cli.mjs', logLevel:'silent'});
+const dir=mkdtempSync(join(tmpdir(),'skylark-cli-'));
+const proxy=join(dir,'proxy.mjs');
+writeFileSync(proxy,`#!/usr/bin/env node
+import {createInterface} from 'node:readline';
+import {appendFileSync} from 'node:fs';
+const data=(name,args)=>{
+ appendFileSync(process.env.CALLS, JSON.stringify({name,args})+'\\n');
+ if(name==='skylark_resolve_url') return {type:'Book',id:9};
+ if(name==='skylark_book_detail') return {id:9,name:'Book',items_count:process.env.BAD_COUNT?JSON.parse(process.env.BAD_COUNT):2};
+ if(name==='skylark_book_toc') return [{type:'DOC',doc_id:1,title:'One'}];
+ if(name==='skylark_doc_list') return process.env.BAD_LIST ? [{id:1}] : [{id:1,title:'One',content_updated_at:'2026-11-12T01:02:03Z'},{id:2,title:'Table',format:'laketable',content_updated_at:'2026-11-12T02:00:00Z'}];
+ if(name==='skylark_doc_detail') return args.doc_id===3?{id:3,title:'Bad'}:{id:args.doc_id,title:'One',body:'Actual body',content_updated_at:'2026-11-12T01:02:03Z'};
+ if(args.action==='table.list')return {tables:[{sheet_id:'s1',title:'People'}]};
+ if(args.action==='table.get')return {table:{sheet:[{columns:[{id:'f1',name:'Name'}]}]}};
+ if(args.action==='record.list')return {records:[{id:1,data:{f1:'A|B'}}],has_more:false};
+ throw Error(name);
+};
+createInterface({input:process.stdin}).on('line',line=>{const m=JSON.parse(line);if(m.id===undefined)return;const result=m.method==='tools/call'?{content:[{type:'text',text:JSON.stringify({ok:true,data:data(m.params.name,m.params.arguments)})}]}:{};process.stdout.write(JSON.stringify({jsonrpc:'2.0',id:m.id,result})+'\\n');});
+`,{mode:0o755});
+const env={...process.env,UTOO_PROXY_BIN:proxy,CALLS:join(dir,'calls'),SKYLARK_MAX_RETRIES:'0'};
+const run=(args,extra={})=>spawnSync(process.execPath,['test/.build/cli.mjs',...args],{env:{...env,...extra},encoding:'utf8'});
+try {
+ const listing=join(dir,'listing.json');
+ let r=run(['listing','--url','https://example/book','--output',listing]);
+ assert.equal(r.status,0,r.stderr);
+ const manifest=JSON.parse(readFileSync(listing,'utf8'));
+ assert.equal(manifest.complete,true);assert.equal(manifest.documents.length,2);
+ assert.equal(readFileSync(env.CALLS,'utf8').includes('skylark_doc_detail'),false);
+ const rejected=join(dir,'incomplete.json');
+ r=run(['listing','--url','https://example/book','--output',rejected],{BAD_LIST:'1'});
+ assert.equal(r.status,1);assert.equal(existsSync(rejected),false);
+ for(const count of ['null','false','"2"']){
+  const bad=join(dir,`count-${count}.json`);
+  r=run(['listing','--url','https://example/book','--output',bad],{BAD_COUNT:count});
+  assert.equal(r.status,1,`invalid count ${count} must not form a complete listing`);
+  assert.equal(existsSync(bad),false);
+ }
+ const request=join(dir,'request.json'),report=join(dir,'report.json');
+ writeFileSync(request,JSON.stringify({schema:'skylark-export-request-1',documents:[{document_id:'1',path:join(dir,'one.md')},{document_id:'2',format:'laketable',path:join(dir,'table.md')},{document_id:'3',path:join(dir,'bad.md')}]}));
+ r=run(['export','--request',request,'--output',report]);
+ assert.equal(r.status,2,r.stderr);
+ const result=JSON.parse(readFileSync(report,'utf8'));
+ assert.deepEqual(result.documents.map(x=>x.status),['completed','completed','failed']);
+ assert.match(readFileSync(join(dir,'one.md'),'utf8'),/Actual body/);
+ assert.match(readFileSync(join(dir,'table.md'),'utf8'),/A\\\|B/);
+ assert.equal(existsSync(join(dir,'bad.md')),false);
+ console.log('Skylark CLI: complete listing, rejection, Markdown/table export and isolated failure passed');
+} finally {rmSync(dir,{recursive:true,force:true});}
