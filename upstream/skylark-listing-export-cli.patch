+#!/usr/bin/env node
+/** Independent read-only CLI. Owns gateway pagination and Markdown export. */
+import { readFileSync, writeFileSync, renameSync, mkdirSync, rmSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { parseArgs } from 'node:util';
+import { callReadWithRetry, unwrapEnvelope, docBody, docHeader, rewriteImageURL } from './index.js';
+
+type Json = Record<string, any>;
+function save(path: string, data: string): void {
+ mkdirSync(dirname(resolve(path)), {recursive:true});
+ const tmp=`${path}.${process.pid}.tmp`;
+ try {writeFileSync(tmp,data);renameSync(tmp,path);} finally {rmSync(tmp,{force:true});}
+}
+async function call(name:string, args:Json): Promise<any> {
+ const {response}=await callReadWithRetry(name,args);
+ const {ok,payload}=unwrapEnvelope(response,name);
+ if(!ok) throw Error(`${name}: ${String(payload.message??payload.error??payload.error_code??'failed')}`);
+ return payload.data;
+}
+function id(value:unknown):number|string {
+ if(typeof value==='number')return value;
+ if(typeof value!=='string'||!value.trim())throw Error('missing document/book ID');
+ return /^\d+$/.test(value)?Number(value):value;
+}
+function version(data:Json):unknown {return data.content_updated_at??data.updated_at??data.version??null;}
+async function listing(url:string, output:string):Promise<number> {
+ const resolved=await call('skylark_resolve_url',{url});
+ if(String(resolved?.type).toLowerCase()!=='book')throw Error('URL must resolve to a book');
+ const book_id=id(resolved.id??resolved.book_id);
+ const book=await call('skylark_book_detail',{book_id});
+ const total=book?.items_count;
+ if(typeof total!=='number'||!Number.isInteger(total)||total<0)throw Error('book items_count is missing or invalid');
+ const documents:Json[]=[], seen=new Set<string>();
+ for(let offset=0;offset<total;offset+=50){
+  const page=await call('skylark_doc_list',{book_id,limit:50,offset});
+  if(!Array.isArray(page)||page.length===0||page.length>50)throw Error(`invalid listing page at ${offset}`);
+  for(const doc of page){
+   const key=String(id(doc?.id));
+   if(seen.has(key))throw Error(`duplicate listing document ${key}`);
+   seen.add(key);documents.push({...doc,document_id:key,version:version(doc)});
+  }
+  process.stderr.write(`listing ${documents.length}/${total}\n`);
+ }
+ if(documents.length!==total)throw Error(`incomplete listing: ${documents.length}/${total}`);
+ const toc=await call('skylark_book_toc',{book_id});
+ if(!Array.isArray(toc))throw Error('invalid book TOC');
+ // Recheck the published count after pagination. The gateway has no snapshot token.
+ const after=await call('skylark_book_detail',{book_id});
+ if(after?.items_count!==book.items_count)throw Error('book changed during listing; repeat listing');
+ save(output,JSON.stringify({schema:'skylark-listing-1',complete:true,book:{...book,book_id,url},documents,toc,captured_at:new Date().toISOString()},null,2)+'\n');
+ return 0;
+}
+function cell(value:any,field:Json={}):string {
+ if(value==null)return '';
+ if(Array.isArray(value))return value.map(v=>cell(v,field)).filter(Boolean).join('<br>');
+ if(typeof value==='object'){
+  if('value' in value)return cell(value.value,field);
+  if(value.src)return `![${String(value.name??'attachment')}](${rewriteImageURL(value.src)})`;
+  value=JSON.stringify(value);
+ }
+ if(['select','multiSelect'].includes(field.type))value=field.options?.find((o:Json)=>String(o.id)===String(value))?.value??value;
+ return String(value).replace(/\r\n?|\n/g,'<br>').replace(/\|/g,'\\|');
+}
+async function tableBody(doc_id:number|string):Promise<string> {
+ const list=await call('skylark_table_call',{action:'table.list',doc_id});
+ const tables=list?.tables??list;
+ if(!Array.isArray(tables))throw Error('invalid table.list');
+ const sections:string[]=[];
+ for(const [n,table] of tables.entries()){
+  const sheet_id=table.sheet_id??table.id;
+  if(!sheet_id)throw Error('table has no sheet ID');
+  const detail=await call('skylark_table_call',{action:'table.get',doc_id,sheet_id});
+  const fields=detail?.table?.sheet?.[0]?.columns;
+  if(!Array.isArray(fields))throw Error('invalid table columns');
+  const lines=[`## ${table.title??`Table ${n+1}`}`,''];
+  if(fields.length){
+   lines.push('| '+fields.map((f:Json)=>cell(f.name)).join(' | ')+' |','| '+fields.map(()=> '---').join(' | ')+' |');
+   const seen=new Set<string>();
+   for(let offset=0;;offset+=200){
+    const page=await call('skylark_table_call',{action:'record.list',doc_id,sheet_id,payload:{limit:200,offset}});
+    if(!Array.isArray(page?.records))throw Error('invalid table records');
+    for(const record of page.records){
+     const key=record.uuid??record.id;
+     if(key!=null){if(seen.has(String(key)))throw Error('duplicate table record');seen.add(String(key));}
+     const values=typeof record.data==='string'?JSON.parse(record.data):record.data;
+     if(!values||typeof values!=='object'||Array.isArray(values))throw Error('invalid table record data');
+     lines.push('| '+fields.map((f:Json)=>cell(values[f.id],f)).join(' | ')+' |');
+    }
+    if(!page.has_more)break;
+    if(!page.records.length)throw Error('table pagination did not advance');
+   }
+  }else lines.push('No columns.');
+  sections.push(lines.join('\n'));
+ }
+ return sections.join('\n\n');
+}
+async function exportDocs(requestPath:string,output:string):Promise<number> {
+ const request=JSON.parse(readFileSync(requestPath,'utf8'));
+ if(request.schema!=='skylark-export-request-1'||!Array.isArray(request.documents))throw Error('invalid export request');
+ const documents:Json[]=[];
+ for(const input of request.documents){
+  const result:Json={document_id:String(input.document_id),path:input.path};
+  let content:string|undefined;
+  try {
+   const doc_id=id(input.document_id);
+   if(typeof input.path!=='string'||!input.path)throw Error('missing output path');
+   const isTable=['table','laketable'].includes(String(input.format).toLowerCase());
+   // For tables, detail metadata brackets record pagination to detect source edits.
+   const data=await call('skylark_doc_detail',{doc_id,format:'md'});
+   if(!data||typeof data!=='object')throw Error('invalid document detail');
+   let body:string;
+   if(isTable){
+    body=await tableBody(doc_id);
+    const after=await call('skylark_doc_detail',{doc_id,format:'md'});
+    if(version(after)!==version(data))throw Error('table changed during export');
+   }else{
+    const check=docBody(data);if(!check.ok)throw Error(check.error);body=check.body;
+   }
+   body=body.replace(/https?:\/\/[^\s<>"')]+/g,url=>rewriteImageURL(url));
+   content=docHeader(data)+body+'\n';
+   Object.assign(result,{status:'completed',version:version(data),metadata:{id:data.id,title:data.title,content_updated_at:data.content_updated_at,updated_at:data.updated_at},bytes:Buffer.byteLength(docHeader(data)+body+'\n')});
+  }catch(error){Object.assign(result,{status:'failed',error:error instanceof Error?error.message:String(error)});}
+  // Local publication failure is a shared command error, never a source failure.
+  if(content!==undefined)save(input.path,content);
+  documents.push(result);process.stderr.write(`export ${result.document_id}: ${result.status}\n`);
+ }
+ const failed=documents.filter(x=>x.status==='failed').length;
+ save(output,JSON.stringify({schema:'skylark-export-result-1',status:failed?'partial':'completed',documents,counts:{total:documents.length,completed:documents.length-failed,failed}},null,2)+'\n');
+ return failed?2:0;
+}
+try {
+ const {values,positionals}=parseArgs({options:{url:{type:'string'},output:{type:'string'},request:{type:'string'},help:{type:'boolean'}},allowPositionals:true});
+ if(values.help){console.log('skylark listing --url BOOK_URL --output JSON\nskylark export --request JSON --output JSON');}
+ else if(!values.output||positionals.length!==1||(positionals[0]==='listing'?!values.url:positionals[0]==='export'?!values.request:true)){
+  process.stderr.write('usage: skylark listing --url URL --output JSON | export --request JSON --output JSON\n');process.exitCode=64;
+ }else{
+  process.exitCode=positionals[0]==='listing'?await listing(values.url!,values.output):await exportDocs(values.request!,values.output);
+  console.log(JSON.stringify({output:resolve(values.output),exit_code:process.exitCode}));
+ }
+}catch(error){process.stderr.write(`${error instanceof Error?error.message:String(error)}\n`);process.exitCode=1;}
