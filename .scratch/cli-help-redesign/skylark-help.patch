+import { build } from 'esbuild';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, rmSync, mkdirSync, readdirSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+await build({ entryPoints: ['cli.ts'], bundle: true, platform: 'node', format: 'esm', outfile: 'test/.build/help-cli.mjs', logLevel: 'silent' });
+const cli = resolve('test/.build/help-cli.mjs');
+
+test('listing short help teaches its scoped first invocation without gateway access', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'skylark-help-'));
+  try {
+    const result = spawnSync(process.execPath, [cli, 'listing', '-h'], {
+      cwd: dir, encoding: 'utf8',
+      env: { ...process.env, HOME: dir, UTOO_PROXY_BIN: '/missing/help-must-not-run-proxy', SKYLARK_MCP_URL: 'invalid://offline' },
+    });
+    assert.equal(result.status, 0, result.stderr);
+    assert.match(result.stdout, /usage: skylark listing/);
+    assert.match(result.stdout, /--url/);
+    assert.match(result.stdout, /skylark-listing-1/);
+    assert.match(result.stdout, /Exit codes:/);
+    assert.deepEqual(readdirSync(dir), []);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('full export help includes its complete installed report and boundary contract', () => {
+  const result = spawnSync(process.execPath, [cli, 'export', '--help', '--full'], {
+    encoding: 'utf8', env: { ...process.env, UTOO_PROXY_BIN: '/missing/help-must-not-run-proxy' },
+  });
+  assert.equal(result.status, 0, result.stderr);
+  for (const text of ['Full contract:', 'skylark-export-request-1', 'skylark-export-result-1', 'metadata', 'content_updated_at', 'bytes', 'duplicate', 'null', 'request file', 'SKYLARK_RETRY_BASE_MS']) {
+    assert.ok(result.stdout.includes(text), `full help must explain ${text}`);
+  }
+});
+
+for (const scope of [[], ['listing'], ['export']]) {
+  for (const flags of [['-h'], ['--help'], ['-h', '--full'], ['--help', '--full']]) {
+    test(`${[...scope, ...flags].join(' ')} is scoped, offline and leaves HOME/cwd unchanged`, () => {
+      const dir = mkdtempSync(join(tmpdir(), 'skylark-help-matrix-'));
+      try {
+        const home = join(dir, 'home'), cwd = join(dir, 'cwd');
+        mkdirSync(home); mkdirSync(cwd);
+        const poison = join(dir, 'proxy.mjs');
+        writeFileSync(poison, `#!/usr/bin/env node\nimport {writeFileSync} from 'node:fs'; writeFileSync(${JSON.stringify(join(dir, 'proxy-called'))}, 'unexpected'); process.exit(98);\n`, { mode: 0o755 });
+        const before = readdirSync(dir, { recursive: true }).sort();
+        const result = spawnSync(process.execPath, [cli, ...scope, ...flags], {
+          cwd, encoding: 'utf8', env: { ...process.env, HOME: home, XDG_CONFIG_HOME: join(home, 'config'), XDG_CACHE_HOME: join(home, 'cache'), UTOO_PROXY_BIN: poison, SKYLARK_MCP_URL: 'invalid://offline', SKYLARK_TIMEOUT_MS: 'bad' },
+        });
+        assert.equal(result.status, 0, result.stderr);
+        assert.equal(result.stderr, '');
+        assert.match(result.stdout, new RegExp(`usage: skylark ${scope[0] ?? 'COMMAND'}`));
+        assert.ok(result.stdout.includes('Environment and authentication:'));
+        assert.ok(result.stdout.includes('Exit codes:'));
+        assert.ok(result.stdout.includes('--help --full'));
+        assert.equal(result.stdout.includes('Full contract:'), flags.includes('--full'));
+        assert.deepEqual(readdirSync(dir, { recursive: true }).sort(), before);
+      } finally { rmSync(dir, { recursive: true, force: true }); }
+    });
+  }
+}
+
+test('root version identifies packaged version with no operational prerequisites', () => {
+  const result = spawnSync(process.execPath, [cli, '--version'], {
+    encoding: 'utf8', env: { ...process.env, HOME: '/missing/home', UTOO_PROXY_BIN: '/missing/proxy' },
+  });
+  assert.equal(result.status, 0, result.stderr);
+  assert.equal(result.stdout.trim(), 'skylark 0.1.0');
+  assert.equal(result.stderr, '');
+});
+
+for (const [args, detail, hint] of [
+  [[], 'command is required', 'skylark --help'],
+  [['unknown'], 'unknown command', 'skylark --help'],
+  [['listing', '--wat'], '--wat', 'skylark listing --help'],
+  [['export', '--wat'], '--wat', 'skylark export --help'],
+  [['listing', '--output', 'out.json'], '--url', 'skylark listing --help'],
+  [['export', '--output', 'out.json'], '--request', 'skylark export --help'],
+  [['listing', '--url', 'https://example.invalid/book'], '--output', 'skylark listing --help'],
+  [['export', '--request', 'in.json'], '--output', 'skylark export --help'],
+  [['listing', '--url'], '--url', 'skylark listing --help'],
+  [['listing', '--request', 'in.json'], '--request belongs to export', 'skylark listing --help'],
+  [['export', '--url', 'url'], '--url belongs to listing', 'skylark export --help'],
+  [['listing', 'extra', '--help'], 'unexpected argument', 'skylark listing --help'],
+  [['--full'], '--full requires', 'skylark --help'],
+  [['export', '--full'], '--full requires', 'skylark export --help'],
+  [['listing', '--version'], 'root option', 'skylark listing --help'],
+]) {
+  test(`invalid usage ${args.join(' ')} gives repairable stderr and exit 64`, () => {
+    const result = spawnSync(process.execPath, [cli, ...args], {
+      encoding: 'utf8', env: { ...process.env, UTOO_PROXY_BIN: '/missing/must-not-run' },
+    });
+    assert.equal(result.status, 64, result.stderr);
+    assert.equal(result.stdout, '');
+    assert.ok(result.stderr.includes(detail), result.stderr);
+    assert.ok(result.stderr.includes(hint), result.stderr);
+  });
+}
