@@ -0,0 +1,227 @@
+"""Public subprocess contracts: no model calls or private helper mocks."""
+import json
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import threading
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+class SourceUpdateCLI(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.graph_dir = self.root / "graphify-out"
+        self.graph_dir.mkdir()
+        self.graph = self.graph_dir / "graph.json"
+        self.graph.write_text(json.dumps({"directed": False, "multigraph": False,
+            "graph": {}, "nodes": [self.node("old", "a.md"), self.node("kept", "b.md")],
+            "links": [], "hyperedges": []}))
+
+    def node(self, label, source):
+        return {"id": label, "label": label, "file_type": "concept", "source_file": source}
+
+    def cli(self, *args, environment=None):
+        env = dict(os.environ, PYTHONPATH=str(ROOT))
+        env.update(environment or {})
+        return subprocess.run([sys.executable, "-m", "graphify", *args], cwd=self.root,
+            env=env, text=True, capture_output=True)
+
+    def update(self, sources, extracted):
+        request = self.root / "request.json"
+        request.write_text(json.dumps({"schema": "graphify-source-update-1.0", "sources": sources}))
+        fixture = self.root / "extraction.json"
+        fixture.write_text(json.dumps({"schema": "graphify-source-extraction-1.0", "sources": extracted}))
+        report = self.root / "result.json"
+        proc = self.cli("update-sources", "--graph-dir", str(self.graph_dir),
+            "--request", str(request), "--extraction", str(fixture), "--output", str(report))
+        self.assertTrue(report.exists(), proc.stdout + proc.stderr)
+        return proc, json.loads(report.read_text()), json.loads(self.graph.read_text())
+
+    def source(self, ident, filename, **extra):
+        return {"source_id": ident, "source_file": filename, "path": filename, **extra}
+
+    def extraction(self, ident, nodes):
+        return {"source_id": ident, "status": "completed", "extraction": {"nodes": nodes, "edges": [], "hyperedges": []}}
+
+    def test_complete_source_replaces_prior_and_keeps_unrequested_sources(self):
+        proc, report, graph = self.update([self.source("a", "a.md")],
+            [self.extraction("a", [self.node("fresh", "untrusted.md")])])
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        self.assertEqual(report["status"], "completed")
+        self.assertEqual({n["label"] for n in graph["nodes"]}, {"fresh", "kept"})
+        self.assertEqual(next(n for n in graph["nodes"] if n["label"] == "fresh")["source_file"], "a.md")
+
+    def test_partial_failure_keeps_prior_contribution_exactly(self):
+        original = json.loads(self.graph.read_text())["nodes"][0]
+        proc, report, graph = self.update([self.source("a", "a.md"), self.source("b", "b.md")],
+            [{"source_id": "a", "status": "failed", "error": "fixture timeout"},
+             self.extraction("b", [self.node("fresh", "b.md")])])
+        self.assertEqual(proc.returncode, 2, proc.stderr)
+        self.assertEqual(report["status"], "partial")
+        self.assertEqual(report["counts"], {"total": 2, "completed": 1, "failed": 1})
+        survivor = next(n for n in graph["nodes"] if n["id"] == original["id"])
+        self.assertEqual({k: survivor[k] for k in original}, original)
+        self.assertNotIn("kept", {n["label"] for n in graph["nodes"]})
+
+    def test_metadata_rename_requires_no_extraction_and_preserves_identity(self):
+        proc, report, graph = self.update([self.source("a", "renamed.md", action="metadata",
+            replace=["a.md"], metadata={"source_url": "https://example.test/a", "version": 9})], [])
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        node = next(n for n in graph["nodes"] if n["id"] == "old")
+        self.assertEqual(node["source_file"], "renamed.md")
+        self.assertEqual(node["version"], 9)
+        inventory = self.root / "inventory.json"
+        proc = self.cli("source-inventory", "--graph-dir", str(self.graph_dir), "--output", str(inventory))
+        self.assertEqual(proc.returncode, 0, proc.stderr)
+        rows = json.loads(inventory.read_text())["sources"]
+        self.assertEqual({r["source_file"] for r in rows}, {"renamed.md", "b.md"})
+        renamed = next(r for r in rows if r["source_file"] == "renamed.md")
+        self.assertEqual(renamed["source_id"], "a")
+        self.assertEqual(renamed["metadata"]["version"], 9)
+
+    def test_normal_update_missing_input_reports_failure_and_leaves_graph(self):
+        before = self.graph.read_bytes()
+        request = self.root / "request.json"
+        request.write_text(json.dumps({"schema": "graphify-source-update-1.0",
+            "sources": [self.source("a", "missing.md")]}))
+        report = self.root / "result.json"
+        proc = self.cli("update-sources", "--graph-dir", str(self.graph_dir),
+            "--request", str(request), "--output", str(report))
+        self.assertEqual(proc.returncode, 2, proc.stderr)
+        result = json.loads(report.read_text())
+        self.assertEqual(result["sources"][0]["status"], "failed")
