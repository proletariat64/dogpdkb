+"""Explicit whole-source updates for external process orchestrators.
+
+This module is part of Graphify, not a client-side graph adapter. Publication
+uses Graphify's existing raw merge, deduplication, and atomic artifact writer.
+"""
+from __future__ import annotations
+
+import argparse
+from copy import deepcopy
+import json
+from pathlib import Path
+import sys
+import tempfile
+
+from graphify.paths import write_json_atomic
+
+
+def _load(path: Path) -> dict:
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(value, dict):
+        raise ValueError(f"expected JSON object: {path}")
+    return value
+
+
+def _inventory(graph: dict) -> list[dict]:
+    rows = {item["source_file"]: dict(item)
+            for item in graph.get("graph", {}).get("source_inventory", [])}
+    for key in ("nodes", "links", "edges", "hyperedges"):
+        for item in graph.get(key, []):
+            source = item.get("source_file")
+            if source:
+                row = rows.setdefault(source, {"source_file": source})
+                if item.get("source_id"):
+                    row.setdefault("source_id", item["source_id"])
+    return [rows[key] for key in sorted(rows)]
+
+
+def _sources(request: dict) -> list[dict]:
+    if request.get("schema") != "graphify-source-update-1.0":
+        raise ValueError("unsupported request schema")
+    rows = request.get("sources")
+    if not isinstance(rows, list):
+        raise ValueError("sources must be a list")
+    seen = set()
+    names = set()
+    owned = set()
+    for row in rows:
+        if not isinstance(row, dict):
+            raise ValueError("source must be an object")
+        for key in ("source_id", "source_file"):
+            if not isinstance(row.get(key), str) or not row[key].strip():
+                raise ValueError(f"source requires nonempty {key}")
+        if row["source_id"] in seen or row["source_file"] in names:
+            raise ValueError("duplicate source_id or source_file")
+        seen.add(row["source_id"])
+        names.add(row["source_file"])
+        if row.get("action", "compile") not in ("compile", "metadata"):
+            raise ValueError("action must be compile or metadata")
+        if not isinstance(row.get("metadata", {}), dict):
+            raise ValueError("metadata must be an object")
+        reserved = {"id", "label", "file_type", "source", "target", "relation", "nodes", "edges", "hyperedges", "source_file", "source_id", "_origin"}
+        if reserved.intersection(row.get("metadata", {})):
+            raise ValueError("metadata cannot override graph identity or structure")
+        replacements = row.get("replace", [row["source_file"]])
+        if not isinstance(replacements, list) or not all(isinstance(x, str) and x for x in replacements):
+            raise ValueError("replace must be a list of nonempty source_file names")
+        affected = set(replacements) | {row["source_file"]}
+        if owned.intersection(affected):
+            raise ValueError("overlapping source replacements")
+        owned.update(affected)
+    return rows
+
+
+def _publish(graph_path: Path, current: dict, sources: list[tuple[dict, dict]]) -> None:
+    from graphify.build import dedupe_nodes, dedupe_edges, merge_raw_extraction
+
+    current = deepcopy(current)
+    inventory = {r["source_file"]: r for r in _inventory(current)}
+    compiled = []
+    for row, extraction in sources:
+        old_names = row.get("replace", [row["source_file"]])
+        if row.get("action") == "metadata":
+            metadata = deepcopy(row.get("metadata", {}))
+            metadata.update(source_file=row["source_file"], source_id=row["source_id"])
+            for key in ("nodes", "links", "edges", "hyperedges"):
+                for item in current.get(key, []):
+                    if item.get("source_file") in old_names:
+                        item.update(metadata)
+        else:
+            compiled.append((row, extraction))
+        previous = {}
+        for old in old_names:
+            previous.update(inventory.pop(old, {}).get("metadata", {}))
+        previous.update(row.get("metadata", {}))
+        inventory[row["source_file"]] = {"source_file": row["source_file"],
+            "source_id": row["source_id"], "metadata": previous}
+    if not compiled:
+        attrs = current.setdefault("graph", {})
+        attrs["source_inventory"] = list(inventory.values())
+        if "hyperedges" in attrs:
+            attrs["hyperedges"] = current.get("hyperedges", [])
+        write_json_atomic(graph_path, current, indent=2)
+        return
+    # Explicit whole-source pruning also handles a successful EMPTY extraction;
+    # ordinary incremental replacement intentionally affects emitted tiers only.
+    prune = [old for row, _ in compiled for old in row.get("replace", [row["source_file"]])]
+    with tempfile.TemporaryDirectory(prefix="graphify-source-update-") as scratch:
+        baseline = Path(scratch) / "graph.json"
+        write_json_atomic(baseline, current)
+        merged = merge_raw_extraction({"nodes": [], "edges": [], "hyperedges": []},
+            graph_path=baseline, prune_sources=prune, root=graph_path.parent.parent)
+    for row, extraction in compiled:
+        metadata = deepcopy(row.get("metadata", {}))
+        metadata.update(source_file=row["source_file"], source_id=row["source_id"])
+        for key in ("nodes", "edges", "hyperedges"):
+            for item in extraction.get(key, []):
+                item = dict(item)
+                item.update(metadata)
+                merged[key].append(item)
+        inventory[row["source_file"]] = {"source_file": row["source_file"],
+            "source_id": row["source_id"], "metadata": row.get("metadata", {})}
+    # Match the existing extract --no-cluster artifact path, while preserving
+    # untouched record identities and attributes (the loader may add origin).
+    published = deepcopy(current)
+    published.setdefault("directed", False)
+    published.setdefault("multigraph", False)
+    published["nodes"] = dedupe_nodes(merged["nodes"])
+    node_ids = {node["id"] for node in published["nodes"]}
+    published["links"] = [edge for edge in dedupe_edges(merged["edges"])
+        if edge.get("source") in node_ids and edge.get("target") in node_ids]
+    published.pop("edges", None)
+    published["hyperedges"] = [item for item in merged["hyperedges"]
+        if all(member in node_ids for member in item.get("nodes", []))]
+    attrs = published.setdefault("graph", {})
+    if "hyperedges" in attrs:
+        attrs["hyperedges"] = published["hyperedges"]
+    attrs["source_inventory"] = list(inventory.values())
+    write_json_atomic(graph_path, published, indent=2)
+
+
+def _extract(row: dict, args: argparse.Namespace) -> dict:
+    path = (args.request.resolve().parent / row.get("path", "")).resolve()
+    if not row.get("path") or not path.is_file():
+        raise ValueError(f"source input not found: {path}")
+    if not path.read_text(encoding="utf-8").strip():
+        return {"nodes": [], "edges": [], "hyperedges": []}
+    from graphify.cache import check_semantic_cache, save_semantic_cache
+    from graphify.llm import (detect_backend, extract_corpus_parallel,
+        _extraction_system, _partial_source_files)
+    prompt = _extraction_system()
+    nodes, edges, hyperedges, missing = check_semantic_cache(
+        [str(path)], root=path.parent, cache_root=args.graph_dir.parent, prompt=prompt)
+    if not missing:
+        print(f"[graphify update-sources] cache hit: {row['source_id']}", flush=True)
+        return {"nodes": nodes, "edges": edges, "hyperedges": hyperedges}
+    backend = args.backend or detect_backend()
+    if not backend:
+        raise ValueError("no semantic backend configured; pass --backend or configure a provider")
+    def progress(index, total, result):
+        print(f"[graphify update-sources] {row['source_id']} chunk {index + 1}/{total}", flush=True)
+    result = extract_corpus_parallel([path], backend=backend, model=args.model,
+        root=path.parent, cache_root=args.graph_dir.parent,
+        max_concurrency=args.max_concurrency, on_chunk_done=progress)
+    if result.get("failed_chunks") or _partial_source_files(result) or result.get("uncovered_files"):
+        raise ValueError("incomplete semantic extraction; prior source contribution retained")
+    save_semantic_cache(result.get("nodes", []), result.get("edges", []),
+        result.get("hyperedges", []), root=path.parent, cache_root=args.graph_dir.parent,
+        allowed_source_files=[path], prompt=prompt)
+    return result
+
+
+def main(command: str, argv: list[str]) -> int:
+    parser = argparse.ArgumentParser(prog=f"graphify {command}")
+    parser.add_argument("--graph-dir", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    if command == "update-sources":
+        parser.add_argument("--request", required=True, type=Path)
+        parser.add_argument("--extraction", type=Path)
+        parser.add_argument("--backend")
+        parser.add_argument("--model")
+        parser.add_argument("--max-concurrency", type=int, default=4)
+    args = parser.parse_args(argv)
+    args.graph_dir = args.graph_dir.resolve()
+    graph_path = args.graph_dir / "graph.json"
+    inputs = [graph_path]
+    if command == "update-sources":
+        inputs.append(args.request.resolve())
+        if args.extraction:
+            inputs.append(args.extraction.resolve())
+        if args.max_concurrency < 1:
+            print("--max-concurrency must be positive", file=sys.stderr)
+            return 1
+    if args.output.resolve() in inputs:
+        print("output must differ from graph/request/extraction inputs", file=sys.stderr)
+        return 1
+    try:
+        current = _load(graph_path) if graph_path.exists() else {}
+        if command == "source-inventory":
+            write_json_atomic(args.output, {"schema": "graphify-source-inventory-1.0",
+                "sources": _inventory(current)}, indent=2)
+            return 0
+        rows = _sources(_load(args.request))
+        extracted = {}
+        if args.extraction:
+            artifact = _load(args.extraction)
+            if artifact.get("schema") != "graphify-source-extraction-1.0":
+                raise ValueError("unsupported extraction schema")
+            artifact_rows = artifact.get("sources")
+            if not isinstance(artifact_rows, list):
+                raise ValueError("extraction sources must be a list")
+            for item in artifact_rows:
+                if not isinstance(item, dict) or not isinstance(item.get("source_id"), str):
+                    raise ValueError("extraction source requires source_id")
+                if item["source_id"] in extracted:
+                    raise ValueError("duplicate extraction source_id")
+                if item.get("status") not in ("completed", "failed"):
+                    raise ValueError("extraction status must be completed or failed")
+                if item["status"] == "completed":
+                    extraction = item.get("extraction")
+                    if not isinstance(extraction, dict):
+                        raise ValueError("completed source requires extraction object")
+                    for key in ("nodes", "edges", "hyperedges"):
+                        if not isinstance(extraction.get(key, []), list) or not all(
+                                isinstance(value, dict) for value in extraction.get(key, [])):
+                            raise ValueError(f"extraction {key} must be a list of objects")
+                extracted[item["source_id"]] = item
+        completed = []
+        reports = []
+        known_sources = {item["source_file"] for item in _inventory(current)}
+        for row in rows:
+            result = extracted.get(row["source_id"], {})
+            if not args.extraction and row.get("action", "compile") == "compile":
+                try:
+                    result = {"status": "completed", "extraction": _extract(row, args)}
+                except Exception as exc:
+                    print(f"[graphify update-sources] {row['source_id']}: {exc}", file=sys.stderr)
+                    result = {"status": "failed", "error": str(exc)}
+            report = {key: row[key] for key in ("source_id", "source_file")}
+            report["action"] = row.get("action", "compile")
+            if row.get("action") == "metadata":
+                if known_sources.intersection(row.get("replace", [row["source_file"]])):
+                    completed.append((row, {}))
+                    report["status"] = "completed"
+                else:
+                    report.update(status="failed", error="metadata source not present in graph inventory")
+            elif result.get("status") == "completed":
+                completed.append((row, result["extraction"]))
+                report["status"] = "completed"
+            else:
+                report.update(status="failed", error=result.get("error", "extraction result missing"))
+            reports.append(report)
+        if completed:
+            _publish(graph_path, current, completed)
+        failed = len(rows) - len(completed)
+        status = "partial" if failed and completed else "failed" if failed else "completed"
+        write_json_atomic(args.output, {"schema": "graphify-source-result-1.0",
+            "status": status, "graph": str(graph_path.resolve()), "sources": reports,
+            "counts": {"total": len(rows), "completed": len(completed), "failed": failed}}, indent=2)
+        return 2 if failed else 0
+    except (ValueError, OSError, KeyError, TypeError, RuntimeError) as exc:
+        print(f"graphify {command}: {exc}", file=sys.stderr)
+        try:
+            write_json_atomic(args.output, {"schema": "graphify-source-result-1.0",
+                "status": "failed", "error": str(exc), "sources": []}, indent=2)
+        except OSError as report_error:
+            print(f"could not write result: {report_error}", file=sys.stderr)
+        return 1
